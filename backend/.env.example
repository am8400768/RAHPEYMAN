# Never commit the real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rahpeyman
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://rahpeyman.ir,https://www.rahpeyman.ir,http://localhost:5500

# Device attestation
REQUIRE_DEVICE_ATTESTATION=false
GOOGLE_CLOUD_PROJECT_NUMBER=
ANDROID_PACKAGE_NAME=com.example.final_listofer
GOOGLE_APPLICATION_CREDENTIALS=

# Private video storage
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=rahpeyman-videos
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

ZARINPAL_MERCHANT_ID=replace-with-your-merchant-id
ZARINPAL_CALLBACK_URL=https://api.rahpeyman.ir/payments/zarinpal/callback
SUBSCRIPTION_PRICE=1000000
SUBSCRIPTION_DAYS=30

KAVENEGAR_API_KEY=replace-with-your-kavenegar-key
