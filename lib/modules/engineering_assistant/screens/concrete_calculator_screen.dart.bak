import 'package:flutter/material.dart';

import '../../estefsarieh/theme/estefsarieh_theme.dart';

class ConcreteCalculatorScreen extends StatefulWidget {
  const ConcreteCalculatorScreen({super.key});

  @override
  State<ConcreteCalculatorScreen> createState() =>
      _ConcreteCalculatorScreenState();
}

class _ConcreteCalculatorScreenState
    extends State<ConcreteCalculatorScreen> {
  // ===========================================================================
  // بتن‌یار — بتن درجا
  // ---------------------------------------------------------------------------
  // منطق این صفحه بر اساس دمو «بتن درجا» ساخته شده است.
  //
  // نکته مهم:
  // هیچ ضریب پرت ۶٪ در این محاسبات وجود ندارد.
  // مقدار سیمان = حجم بتن × عیار سیمان
  // ===========================================================================

  static const Color _concreteColor = Color(0xFF7C97AE);
  static const Color _concreteSoft = Color(0x147C97AE);

  static const double _bagWeight = 50.0;
  static const double _aggregateTonPerM3 = 2.2;

  static const List<_ConcreteGrade> _grades = [
    _ConcreteGrade(
      title: 'بتن مگر / نظافت',
      grade: '۱۰۰ کیلوگرم',
      cementKgM3: 100,
    ),
    _ConcreteGrade(
      title: 'بتن مگر / نظافت',
      grade: '۱۵۰ کیلوگرم',
      cementKgM3: 150,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۱۲ مگاپاسکال',
      grade: 'عیار ۲۲۰',
      cementKgM3: 220,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۱۶ مگاپاسکال',
      grade: 'عیار ۲۶۰',
      cementKgM3: 260,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۲۰ مگاپاسکال',
      grade: 'عیار ۳۰۰',
      cementKgM3: 300,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۲۵ مگاپاسکال',
      grade: 'عیار ۳۵۰',
      cementKgM3: 350,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۳۰ مگاپاسکال',
      grade: 'عیار ۴۰۰',
      cementKgM3: 400,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۳۵ مگاپاسکال',
      grade: 'عیار ۴۵۰',
      cementKgM3: 450,
    ),
    _ConcreteGrade(
      title: 'بتن رده ۴۰ مگاپاسکال',
      grade: 'عیار ۵۰۰',
      cementKgM3: 500,
    ),
  ];

  final TextEditingController _volumeController =
      TextEditingController();

  final TextEditingController _cementPriceController =
      TextEditingController();

  final TextEditingController _aggregatePriceController =
      TextEditingController();

  int _gradeIndex = 5;

  double? _volume;
  int _cementPrice = 0;
  int _aggregatePrice = 0;

  _ConcreteGrade get _selectedGrade => _grades[_gradeIndex];

  double? get _cementKg {
    if (_volume == null || _volume! <= 0) {
      return null;
    }

    // بدون هیچ ضریب پرت.
    return _volume! * _selectedGrade.cementKgM3;
  }

  double? get _aggregateTon {
    if (_volume == null || _volume! <= 0) {
      return null;
    }

    return _volume! * _aggregateTonPerM3;
  }

  double? get _cementBags {
    final cement = _cementKg;

    if (cement == null) {
      return null;
    }

    return (cement / _bagWeight).ceilToDouble();
  }

  double? get _cementCost {
    final bags = _cementBags;

    if (bags == null) {
      return null;
    }

    return bags * _cementPrice;
  }

  double? get _aggregateCost {
    final aggregate = _aggregateTon;

    if (aggregate == null) {
      return null;
    }

    return aggregate * _aggregatePrice;
  }

  double? get _totalCost {
    final cement = _cementCost;
    final aggregate = _aggregateCost;

    if (cement == null || aggregate == null) {
      return null;
    }

    return cement + aggregate;
  }

  double? get _unitCost {
    if (_volume == null || _volume! <= 0) {
      return null;
    }

    final total = _totalCost;

    if (total == null) {
      return null;
    }

    return total / _volume!;
  }

  @override
  void dispose() {
    _volumeController.dispose();
    _cementPriceController.dispose();
    _aggregatePriceController.dispose();
    super.dispose();
  }

  // ===========================================================================
  // Number helpers
  // ===========================================================================

  double? _parseNumber(String value) {
    final normalized = value
        .replaceAll(',', '')
        .replaceAll('٬', '')
        .replaceAll('،', '')
        .trim();

    if (normalized.isEmpty) {
      return null;
    }

    return double.tryParse(normalized);
  }

  int _parseInteger(String value) {
    final normalized = value
        .replaceAll(',', '')
        .replaceAll('٬', '')
        .replaceAll('،', '')
        .trim();

    if (normalized.isEmpty) {
      return 0;
    }

    return int.tryParse(normalized) ?? 0;
  }

  String _formatNumber(
    num value, {
    int decimals = 0,
    bool trimZeros = true,
  }) {
    String result;

    if (decimals == 0) {
      result = value.round().toString();
    } else {
      result = value.toStringAsFixed(decimals);

      if (trimZeros) {
        result = result.replaceFirst(
          RegExp(r'\.?0+$'),
          '',
        );
      }
    }

    final negative = result.startsWith('-');
    final clean = negative ? result.substring(1) : result;

    final parts = clean.split('.');
    final integerPart = parts[0];

    final buffer = StringBuffer();

    for (var i = 0; i < integerPart.length; i++) {
      if (i > 0 &&
          (integerPart.length - i) % 3 == 0) {
        buffer.write(',');
      }

      buffer.write(integerPart[i]);
    }

    if (parts.length > 1) {
      buffer.write('.');
      buffer.write(parts[1]);
    }

    return negative ? '-${buffer.toString()}' : buffer.toString();
  }

  String _formatPrice(num value) {
    return _formatNumber(value, decimals: 0);
  }

  void _updateVolume(String value) {
    setState(() {
      _volume = _parseNumber(value);
    });
  }

  void _updateCementPrice(String value) {
    setState(() {
      _cementPrice = _parseInteger(value);
    });
  }

  void _updateAggregatePrice(String value) {
    setState(() {
      _aggregatePrice = _parseInteger(value);
    });
  }

  void _selectGrade(int index) {
    setState(() {
      _gradeIndex = index;
    });
  }

  // ===========================================================================
  // UI
  // ===========================================================================

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        backgroundColor: EstefsariehColors.bgBase,
        appBar: AppBar(
          elevation: 0,
          backgroundColor: EstefsariehColors.primary,
          foregroundColor: Colors.white,
          titleSpacing: 0,
          title: const Text(
            'بتن‌یار',
            style: TextStyle(
              fontFamily: 'IRANSansWeb(FaNum)',
              fontWeight: FontWeight.w700,
            ),
          ),
          leading: IconButton(
            tooltip: 'بازگشت',
            onPressed: () => Navigator.of(context).pop(),
            icon: const Icon(
              Icons.arrow_forward_rounded,
            ),
          ),
        ),
        body: SafeArea(
          child: CustomScrollView(
            physics: const BouncingScrollPhysics(),
            slivers: [
              SliverToBoxAdapter(
                child: _buildHeader(),
              ),
              SliverToBoxAdapter(
                child: _buildInputPanel(),
              ),
              if (_volume != null && _volume! > 0)
                SliverToBoxAdapter(
                  child: _buildResultPanel(),
                ),
              if (_volume != null && _volume! > 0)
                SliverToBoxAdapter(
                  child: _buildPricePanel(),
                ),
              if (_volume != null &&
                  _volume! > 0 &&
                  _cementPrice > 0 &&
                  _aggregatePrice > 0)
                SliverToBoxAdapter(
                  child: _buildCostPanel(),
                ),
              SliverToBoxAdapter(
                child: _buildFormulaPanel(),
              ),
              SliverToBoxAdapter(
                child: _buildFooter(),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildHeader() {
    return Padding(
      padding: const EdgeInsets.fromLTRB(
        16,
        18,
        16,
        8,
      ),
      child: Container(
        padding: const EdgeInsets.all(16),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(18),
          border: Border.all(
            color: EstefsariehColors.borderSoft,
          ),
          boxShadow: EstefsariehDecor.cardShadow,
        ),
        child: Row(
          children: [
            Container(
              width: 52,
              height: 52,
              decoration: BoxDecoration(
                color: _concreteSoft,
                borderRadius: BorderRadius.circular(16),
              ),
              child: const Icon(
                Icons.foundation_rounded,
                color: _concreteColor,
                size: 28,
              ),
            ),
            const SizedBox(width: 13),
            const Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'بتن درجا',
                    style: TextStyle(
                      fontFamily: 'IRANSansWeb(FaNum)',
                      fontSize: 16,
                      fontWeight: FontWeight.w700,
                      color: EstefsariehColors.primary,
                    ),
                  ),
                  SizedBox(height: 4),
                  Text(
                    'رده بتن، عیار سیمان، شن و ماسه',
                    style: TextStyle(
                      fontFamily: 'Vazirmatn',
                      fontSize: 11.5,
                      height: 1.6,
                      color: EstefsariehColors.textMuted,
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildInputPanel() {
    return _buildPanel(
      index: '۱',
      title: 'رده و حجم بتن',
      child: Column(
        children: [
          _buildFieldLabel('رده بتن'),
          const SizedBox(height: 7),
          _buildGradeSelector(),
          const SizedBox(height: 16),
          _buildFieldLabel('حجم بتن'),
          const SizedBox(height: 7),
          _buildNumberField(
            controller: _volumeController,
            hint: 'مثلاً 10',
            suffix: 'm³',
            keyboardType: const TextInputType.numberWithOptions(
              decimal: true,
            ),
            onChanged: _updateVolume,
          ),
        ],
      ),
    );
  }

  Widget _buildGradeSelector() {
    return Container(
      decoration: BoxDecoration(
        color: EstefsariehColors.panel2,
        borderRadius: BorderRadius.circular(13),
        border: Border.all(
          color: EstefsariehColors.borderSoft,
        ),
      ),
      padding: const EdgeInsets.symmetric(
        horizontal: 12,
        vertical: 2,
      ),
      child: DropdownButtonHideUnderline(
        child: DropdownButton<int>(
          value: _gradeIndex,
          isExpanded: true,
          icon: const Icon(
            Icons.keyboard_arrow_down_rounded,
            color: EstefsariehColors.primary,
          ),
          style: const TextStyle(
            fontFamily: 'Vazirmatn',
            fontSize: 12.5,
            color: EstefsariehColors.primary,
          ),
          items: List.generate(
            _grades.length,
            (index) {
              final grade = _grades[index];

              return DropdownMenuItem<int>(
                value: index,
                child: Text(
                  '${grade.title} — ${grade.cementKgM3} kg/m³',
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    fontFamily: 'Vazirmatn',
                    fontSize: 12.5,
                    fontWeight: FontWeight.w500,
                  ),
                ),
              );
            },
          ),
          onChanged: (value) {
            if (value != null) {
              _selectGrade(value);
            }
          },
        ),
      ),
    );
  }

  Widget _buildResultPanel() {
    final cement = _cementKg;
    final aggregate = _aggregateTon;
    final bags = _cementBags;

    return _buildPanel(
      index: '◆',
      title: 'مصالح مورد نیاز',
      child: Column(
        children: [
          Row(
            children: [
              Expanded(
                child: _buildResultCard(
                  title: 'سیمان مصرفی',
                  value: cement == null
                      ? '—'
                      : _formatNumber(
                          cement,
                          decimals: 1,
                        ),
                  unit: 'kg',
                  hero: true,
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _buildResultCard(
                  title: 'شن و ماسه',
                  value: aggregate == null
                      ? '—'
                      : _formatNumber(
                          aggregate,
                          decimals: 2,
                        ),
                  unit: 'تن',
                ),
              ),
            ],
          ),
          const SizedBox(height: 11),
          Container(
            width: double.infinity,
            padding: const EdgeInsets.symmetric(
              horizontal: 16,
              vertical: 16,
            ),
            decoration: BoxDecoration(
              color: _concreteSoft,
              borderRadius: BorderRadius.circular(15),
              border: Border.all(
                color: _concreteColor.withValues(
                  alpha: 0.25,
                ),
              ),
            ),
            child: Column(
              children: [
                const Text(
                  'سیمان به کیسه ۵۰ کیلویی',
                  style: TextStyle(
                    fontFamily: 'Vazirmatn',
                    fontSize: 11.5,
                    color: EstefsariehColors.textMuted,
                  ),
                ),
                const SizedBox(height: 6),
                Text(
                  bags == null
                      ? '—'
                      : _formatNumber(
                          bags,
                          decimals: 0,
                        ),
                  style: const TextStyle(
                    fontFamily: 'IRANSansWeb(FaNum)',
                    fontSize: 23,
                    fontWeight: FontWeight.w800,
                    color: _concreteColor,
                  ),
                ),
                const SizedBox(height: 2),
                const Text(
                  'کیسه',
                  style: TextStyle(
                    fontFamily: 'Vazirmatn',
                    fontSize: 10.5,
                    color: EstefsariehColors.textMuted,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPricePanel() {
    return _buildPanel(
      index: '۲',
      title: 'قیمت واحد مصالح',
      child: Column(
        children: [
          _buildPriceField(
            label: 'قیمت هر کیسه سیمان',
            controller: _cementPriceController,
            onChanged: _updateCementPrice,
            iconColor: EstefsariehColors.textMuted,
          ),
          const SizedBox(height: 10),
          _buildPriceField(
            label: 'قیمت هر تن شن و ماسه',
            controller: _aggregatePriceController,
            onChanged: _updateAggregatePrice,
            iconColor: EstefsariehColors.primary,
          ),
        ],
      ),
    );
  }

  Widget _buildCostPanel() {
    final unitCost = _unitCost;
    final totalCost = _totalCost;
    final cementCost = _cementCost;
    final aggregateCost = _aggregateCost;
    final bags = _cementBags;
    final aggregate = _aggregateTon;

    return _buildPanel(
      index: '◆',
      title: 'هزینه تمام‌شده',
      child: Column(
        children: [
          Row(
            children: [
              Expanded(
                child: _buildCostHero(
                  title: 'قیمت هر مترمکعب بتن',
                  value: unitCost == null
                      ? '—'
                      : _formatPrice(unitCost),
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _buildCostHero(
                  title: 'جمع کل',
                  value: totalCost == null
                      ? '—'
                      : _formatPrice(totalCost),
                  grand: true,
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          _buildBreakdownRow(
            'سیمان (${bags == null ? '—' : _formatNumber(bags)} کیسه)',
            cementCost == null
                ? '—'
                : _formatPrice(cementCost),
          ),
          const SizedBox(height: 7),
          _buildBreakdownRow(
            'شن و ماسه (${aggregate == null ? '—' : _formatNumber(aggregate, decimals: 2)} تن)',
            aggregateCost == null
                ? '—'
                : _formatPrice(aggregateCost),
          ),
        ],
      ),
    );
  }

  Widget _buildFormulaPanel() {
    return Padding(
      padding: const EdgeInsets.fromLTRB(
        16,
        8,
        16,
        8,
      ),
      child: Container(
        padding: const EdgeInsets.all(15),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(16),
          border: Border.all(
            color: EstefsariehColors.borderSoft,
          ),
          boxShadow: EstefsariehDecor.cardShadow,
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'فرمول محاسبه',
              style: TextStyle(
                fontFamily: 'IRANSansWeb(FaNum)',
                fontSize: 13,
                fontWeight: FontWeight.w700,
                color: EstefsariehColors.primary,
              ),
            ),
            const SizedBox(height: 9),
            _buildFormulaLine(
              'سیمان',
              'حجم بتن × عیار سیمان',
            ),
            const SizedBox(height: 6),
            _buildFormulaLine(
              'شن و ماسه',
              'حجم بتن × ۲٫۲ تن',
            ),
            const SizedBox(height: 8),
            const Text(
              'محاسبات بدون اعمال ضریب پرت انجام می‌شود.',
              style: TextStyle(
                fontFamily: 'Vazirmatn',
                fontSize: 10.5,
                height: 1.6,
                color: EstefsariehColors.textMuted,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildFooter() {
    return const Padding(
      padding: EdgeInsets.fromLTRB(
        20,
        8,
        20,
        24,
      ),
      child: Column(
        children: [
          Divider(
            color: EstefsariehColors.borderSoft,
          ),
          SizedBox(height: 9),
          Text(
            'رهپیمان — همراه مهندسین از آموزش تا اجرا',
            textAlign: TextAlign.center,
            style: TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 9.5,
              color: EstefsariehColors.textMuted,
            ),
          ),
        ],
      ),
    );
  }

  // ===========================================================================
  // Reusable widgets
  // ===========================================================================

  Widget _buildPanel({
    required String index,
    required String title,
    required Widget child,
  }) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(
        16,
        8,
        16,
        8,
      ),
      child: Container(
        padding: const EdgeInsets.all(15),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(18),
          border: Border.all(
            color: EstefsariehColors.borderSoft,
          ),
          boxShadow: EstefsariehDecor.cardShadow,
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Container(
                  width: 25,
                  height: 25,
                  alignment: Alignment.center,
                  decoration: BoxDecoration(
                    color: _concreteSoft,
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Text(
                    index,
                    style: const TextStyle(
                      fontFamily: 'IRANSansWeb(FaNum)',
                      fontSize: 10.5,
                      fontWeight: FontWeight.w700,
                      color: _concreteColor,
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                Text(
                  title,
                  style: const TextStyle(
                    fontFamily: 'IRANSansWeb(FaNum)',
                    fontSize: 13.5,
                    fontWeight: FontWeight.w700,
                    color: EstefsariehColors.primary,
                  ),
                ),
                const SizedBox(width: 10),
                const Expanded(
                  child: Divider(
                    color: EstefsariehColors.borderSoft,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 15),
            child,
          ],
        ),
      ),
    );
  }

  Widget _buildFieldLabel(String text) {
    return Align(
      alignment: Alignment.centerRight,
      child: Text(
        text,
        style: const TextStyle(
          fontFamily: 'Vazirmatn',
          fontSize: 11.5,
          fontWeight: FontWeight.w600,
          color: EstefsariehColors.textMuted,
        ),
      ),
    );
  }

  Widget _buildNumberField({
    required TextEditingController controller,
    required String hint,
    required String suffix,
    required TextInputType keyboardType,
    required ValueChanged<String> onChanged,
  }) {
    return TextField(
      controller: controller,
      keyboardType: keyboardType,
      textDirection: TextDirection.ltr,
      textAlign: TextAlign.right,
      onChanged: onChanged,
      style: const TextStyle(
        fontFamily: 'IRANSansWeb(FaNum)',
        fontSize: 16,
        fontWeight: FontWeight.w600,
        color: EstefsariehColors.primary,
      ),
      decoration: InputDecoration(
        hintText: hint,
        hintStyle: const TextStyle(
          fontFamily: 'Vazirmatn',
          fontSize: 12,
          color: EstefsariehColors.textMuted,
        ),
        suffixIcon: Padding(
          padding: const EdgeInsetsDirectional.only(
            start: 8,
            end: 10,
          ),
          child: Center(
            widthFactor: 1,
            child: Text(
              suffix,
              style: const TextStyle(
                fontFamily: 'Vazirmatn',
                fontSize: 11,
                color: EstefsariehColors.textMuted,
              ),
            ),
          ),
        ),
        filled: true,
        fillColor: EstefsariehColors.panel2,
        contentPadding: const EdgeInsets.symmetric(
          horizontal: 13,
          vertical: 13,
        ),
        enabledBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(13),
          borderSide: const BorderSide(
            color: EstefsariehColors.borderSoft,
          ),
        ),
        focusedBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(13),
          borderSide: const BorderSide(
            color: _concreteColor,
            width: 1.2,
          ),
        ),
      ),
    );
  }

  Widget _buildPriceField({
    required String label,
    required TextEditingController controller,
    required ValueChanged<String> onChanged,
    required Color iconColor,
  }) {
    return Row(
      children: [
        Expanded(
          flex: 5,
          child: Row(
            children: [
              Container(
                width: 8,
                height: 8,
                decoration: BoxDecoration(
                  color: iconColor,
                  shape: BoxShape.circle,
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: Text(
                  label,
                  style: const TextStyle(
                    fontFamily: 'Vazirmatn',
                    fontSize: 11.5,
                    color: EstefsariehColors.textMuted,
                  ),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(width: 10),
        Expanded(
          flex: 4,
          child: TextField(
            controller: controller,
            keyboardType: TextInputType.number,
            textDirection: TextDirection.ltr,
            textAlign: TextAlign.right,
            onChanged: onChanged,
            style: const TextStyle(
              fontFamily: 'IRANSansWeb(FaNum)',
              fontSize: 13,
              fontWeight: FontWeight.w600,
              color: EstefsariehColors.primary,
            ),
            decoration: InputDecoration(
              hintText: '0',
              hintStyle: const TextStyle(
                fontFamily: 'Vazirmatn',
                color: EstefsariehColors.textMuted,
              ),
              suffixText: 'ریال',
              suffixStyle: const TextStyle(
                fontFamily: 'Vazirmatn',
                fontSize: 9.5,
                color: EstefsariehColors.textMuted,
              ),
              filled: true,
              fillColor: EstefsariehColors.panel2,
              contentPadding: const EdgeInsets.symmetric(
                horizontal: 10,
                vertical: 11,
              ),
              enabledBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(11),
                borderSide: const BorderSide(
                  color: EstefsariehColors.borderSoft,
                ),
              ),
              focusedBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(11),
                borderSide: const BorderSide(
                  color: _concreteColor,
                  width: 1.2,
                ),
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildResultCard({
    required String title,
    required String value,
    required String unit,
    bool hero = false,
  }) {
    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 11,
        vertical: 12,
      ),
      decoration: BoxDecoration(
        color: hero ? _concreteSoft : EstefsariehColors.panel2,
        borderRadius: BorderRadius.circular(13),
        border: Border.all(
          color: hero
              ? _concreteColor.withValues(alpha: 0.28)
              : EstefsariehColors.borderSoft,
        ),
      ),
      child: Column(
        children: [
          Text(
            title,
            textAlign: TextAlign.center,
            style: const TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 10,
              color: EstefsariehColors.textMuted,
            ),
          ),
          const SizedBox(height: 7),
          Text(
            value,
            textAlign: TextAlign.center,
            style: TextStyle(
              fontFamily: 'IRANSansWeb(FaNum)',
              fontSize: hero ? 18 : 16,
              fontWeight: FontWeight.w800,
              color: hero
                  ? _concreteColor
                  : EstefsariehColors.primary,
            ),
          ),
          const SizedBox(height: 2),
          Text(
            unit,
            style: const TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 9,
              color: EstefsariehColors.textMuted,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildCostHero({
    required String title,
    required String value,
    bool grand = false,
  }) {
    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 10,
        vertical: 14,
      ),
      decoration: BoxDecoration(
        color: grand ? _concreteSoft : EstefsariehColors.panel2,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: grand
              ? _concreteColor.withValues(alpha: 0.28)
              : EstefsariehColors.borderSoft,
        ),
      ),
      child: Column(
        children: [
          Text(
            title,
            textAlign: TextAlign.center,
            style: const TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 9.5,
              color: EstefsariehColors.textMuted,
            ),
          ),
          const SizedBox(height: 7),
          Text(
            value,
            textAlign: TextAlign.center,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: TextStyle(
              fontFamily: 'IRANSansWeb(FaNum)',
              fontSize: grand ? 16 : 14,
              fontWeight: FontWeight.w800,
              color: grand
                  ? _concreteColor
                  : EstefsariehColors.primary,
            ),
          ),
          const SizedBox(height: 2),
          const Text(
            'ریال',
            style: TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 8.5,
              color: EstefsariehColors.textMuted,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildBreakdownRow(
    String label,
    String value,
  ) {
    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 11,
        vertical: 9,
      ),
      decoration: BoxDecoration(
        color: EstefsariehColors.panel2,
        borderRadius: BorderRadius.circular(10),
      ),
      child: Row(
        children: [
          Expanded(
            child: Text(
              label,
              style: const TextStyle(
                fontFamily: 'Vazirmatn',
                fontSize: 10.5,
                color: EstefsariehColors.textMuted,
              ),
            ),
          ),
          Text(
            value,
            style: const TextStyle(
              fontFamily: 'IRANSansWeb(FaNum)',
              fontSize: 11.5,
              fontWeight: FontWeight.w700,
              color: EstefsariehColors.primary,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildFormulaLine(
    String title,
    String formula,
  ) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        SizedBox(
          width: 55,
          child: Text(
            title,
            style: const TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 10.5,
              fontWeight: FontWeight.w700,
              color: EstefsariehColors.textMuted,
            ),
          ),
        ),
        Expanded(
          child: Text(
            formula,
            style: const TextStyle(
              fontFamily: 'Vazirmatn',
              fontSize: 10.5,
              color: EstefsariehColors.primary,
            ),
          ),
        ),
      ],
    );
  }
}

class _ConcreteGrade {
  const _ConcreteGrade({
    required this.title,
    required this.grade,
    required this.cementKgM3,
  });

  final String title;
  final String grade;
  final double cementKgM3;
}
